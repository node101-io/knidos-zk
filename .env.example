# Hyperliquid API
# /info is public, so there is no key or secret. The address identifies the
# account; the circuit commits to sha256(address || salt) rather than
# publishing it. One response covers every coin, so a window is a single proof.
HYPERLIQUID_API_URL="https://api.hyperliquid.xyz/info"
HYPERLIQUID_USER_ADDRESS="<YOUR_WALLET_ADDRESS>"

# Primus Network (for zkTLS)
PRIMUS_PRIVATE_KEY="<YOUR_PRIVATE_KEY>"
PRIMUS_USER_ADDRESS="<YOUR_WALLET_ADDRESS>"
PRIMUS_CHAIN_ID=84532

# RPC endpoint (Base Sepolia)
RPC_URL="https://sepolia.base.org"
# Optional comma-separated fallback RPCs for read failover
RPC_FALLBACK_URLS="https://base-sepolia.example-rpc-1,https://base-sepolia.example-rpc-2"

# zkVerify account
ZKVERIFY_SEED_PHRASE="<YOUR_SEED_PHRASE>"
# zkVerify network: "volta" (testnet) or "mainnet"
ZKVERIFY_NETWORK="volta"
# zkVerify aggregation domain id (optional). Leave empty to submit without aggregation.
# Volta: 0 for default public aggregation. Mainnet: leave empty, or use 2 (Base) / 3 (Horizen).
ZKVERIFY_DOMAIN_ID=0

# MongoDB connection
MONGO_URI="mongodb://127.0.0.1:27017/node101-knidos-zk-trade"

# API authentication (shared by zk-node + testnet-challenge APIs)
API_KEY="<YOUR_API_KEY>"

# Scheduler (optional, default 60; supports aligned sub-hour or whole-hour windows)
ZKTLS_WINDOW_MINUTES=60

# Success monitoring
# Check once per day; expects at least one settled proof per scheduler window.
# Use /notify/<key> here if the deployed Apprise instance uses a stateful config.
APPRISE_NOTIFY_URL="<YOUR_APPRISE_NOTIFY_URL>"
APPRISE_USERNAME="<YOUR_APPRISE_BASIC_AUTH_USERNAME>"
APPRISE_PASSWORD="<YOUR_APPRISE_BASIC_AUTH_PASSWORD>"

# Node runtime
NODE_ENV="development"
# Log output format: "json" or "pretty". Defaults to json (pretty in development).
# Keep json in production so logs stay jq-filterable; set pretty when you want the
# daemon to print the colorized human stream itself (no host-side tooling needed).
LOG_FORMAT="json"
