{
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "rm -rf dist",
    "node": "node dist/src/app.js",
    "tasks:retry": "tsx src/scripts/retry-failed-tasks.ts",
    "dev:node": "tsx watch src/app.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "db:reset": "mongosh --eval 'db.dropDatabase()' node101-knidos-zk-trade && redis-cli FLUSHDB",
    "postinstall": "git submodule update --init && cd noir_json_parser && git apply --check ../patches/noir_json_parser.patch 2>/dev/null && git apply ../patches/noir_json_parser.patch || echo 'Patch already applied'"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@noir-lang/noir_js": "1.0.0-beta.6",
    "@primuslabs/network-core-sdk": "^0.1.11",
    "@t3-oss/env-core": "^0.13.8",
    "bullmq": "^5.73.1",
    "dotenv": "^17.4.1",
    "ethers": "^5.8.0",
    "hono": "^4.12.12",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.10.1",
    "mongoose": "^9.4.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zkverifyjs": "^2.3.0",
    "zod": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@polkadot/util": "13.5.9",
      "@polkadot/util-crypto": "13.5.9"
    },
    "packageExtensions": {
      "@primuslabs/network-core-sdk": {
        "dependencies": {
          "node-gyp": "*"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "node-gyp": "^12.2.0",
    "oxlint": "^1.59.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
