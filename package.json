{
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "rm -rf dist",
    "node": "node dist/src/app.js",
    "dev:node": "tsx watch src/app.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "db:reset": "mongosh --eval 'db.dropDatabase()' node101-knidos-zk-trade && redis-cli FLUSHDB",
    "postinstall": "git submodule update --init && cd noir_json_parser && git apply --check ../patches/noir_json_parser.patch 2>/dev/null && git apply ../patches/noir_json_parser.patch || echo 'Patch already applied'"
  },
  "dependencies": {
    "@noir-lang/noir_js": "1.0.0-beta.6",
    "@primuslabs/network-core-sdk": "^0.1.11",
    "@t3-oss/env-core": "^0.13.8",
    "bullmq": "^5.73.1",
    "dotenv": "^17.4.1",
    "ethers": "^5.8.0",
    "ioredis": "^5.10.1",
    "mongoose": "^9.4.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zkverifyjs": "^2.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "node-gyp": "^12.2.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
