{
  "name": "zk-node",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "cp src/agent-card.json dist/src/agent-card.json",
    "clean": "rm -rf dist",
    "prebuild": "rm -rf dist",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --project=unit",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:e2e": "vitest run --project=e2e-zktls --project=e2e-zkverify",
    "test:all": "vitest run",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:coverage:integration": "vitest run --project=unit --project=integration --coverage",
    "test:coverage:all": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@noir-lang/noir_js": "1.0.0-beta.6",
    "@primuslabs/network-core-sdk": "^0.1.15",
    "@t3-oss/env-core": "^0.13.8",
    "bullmq": "^5.73.1",
    "croner": "^10.0.1",
    "ethers": "^5.8.0",
    "hono": "^4.12.12",
    "ioredis": "^5.10.1",
    "mongoose": "^9.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zkverifyjs": "^3.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.4",
    "node-gyp": "^12.2.0",
    "ts-node": "^10.9.2",
    "vitest": "^4.1.4"
  }
}
